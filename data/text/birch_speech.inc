gText_Birch_Welcome::
	.string "Ciao! Scusa l'attesa!\\p"
	.string "Benvenuto nel mondo dei POKéMON!\\p"
	.string "Mi chiamo BIRCH.\\p"
	.string "Sono un PROFESSORE che studia\\n"
	.string "i POKéMON.\\p"
	.string "$"

gText_Birch_Pokemon::
	.string "Questo e' un POKéMON.\\p"
	.string "\\n"
	.string "$"

gText_Birch_MainSpeech::
	.string "Il nostro mondo e' abitato da\\n"
	.string "creature chiamate POKéMON.\\p"
	.string "Viviamo insieme a loro,\\n"
	.string "come amici e compagni.\\p"
	.string "A volte ci aiutano nel lavoro,\\n"
	.string "altre volte lottano con noi.\\p"
	.string "Ma c'e' ancora molto che\\n"
	.string "non sappiamo sui POKéMON.\\p"
	.string "Alcuni misteri sembrano\\n"
	.string "legare regioni lontane...\\p"
	.string "Per questo continuo le mie\\n"
	.string "ricerche.\\p"
	.string "$"

gText_Birch_AndYouAre::
	.string "E tu chi sei?$"

gText_Birch_BoyOrGirl::
	.string "Sei un ragazzo?\\n"
	.string "O una ragazza?$"

gText_Birch_WhatsYourName::
	.string "Bene!\\n"
	.string "Come ti chiami?$"

gText_Birch_SoItsPlayer::
	.string "Quindi ti chiami {PLAYER}{KUN}?$"

gText_Birch_YourePlayer::
	.string "Ah, capisco!\\p"
	.string "Sei {PLAYER}{KUN}, che si trasferisce\\n"
	.string "a SOLAROSA, la mia citta'!\\p"
	.string "$"

gText_Birch_AreYouReady::
	.string "Bene, sei pronto?\\p"
	.string "La tua avventura sta per\\n"
	.string "cominciare.\\p"
	.string "Ci sono luoghi da esplorare\\n"
	.string "e misteri da scoprire.\\p"
	.string "Ti aspetto al mio\\n"
	.string "LABORATORIO POKéMON!\\p"
	.string "$"
