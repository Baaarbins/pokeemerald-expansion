gControlsGuide_Text_Intro::
	.string "Ecco i comandi principali.\n"
	.string "Imparali prima di partire.$"

gControlsGuide_Text_DPad::
	.string "Muove il personaggio.\n"
	.string "Serve anche a scegliere le voci.$"

gControlsGuide_Text_AButton::
	.string "Conferma, esamina, parla\n"
	.string "e fa avanzare i dialoghi.$"

gControlsGuide_Text_BButton::
	.string "Annulla una scelta o\n"
	.string "torna indietro.$"

gControlsGuide_Text_StartButton::
	.string "Apre il MENU.$"

gControlsGuide_Text_SelectButton::
	.string "Serve a usare uno\n"
	.string "strumento registrato.$"

gControlsGuide_Text_LRButtons::
	.string "Premi L o R per ricevere\n"
	.string "informazioni e aiuto.$"

gOakSpeech_Text_AskPlayerGender::
	.string "Dimmi una cosa.\n"
	.string "Sei un ragazzo o una ragazza?$"

gPikachuIntro_Text_Page1::
	.string "Stai per entrare in un mondo\n"
	.string "pieno di POKéMON e avventure.\n\n"
	.string "Parla con le persone e\n"
	.string "osserva tutto con attenzione.$"

gPikachuIntro_Text_Page2::
	.string "Aiutando chi ne ha bisogno,\n"
	.string "affronterai nuove sfide.\n\n"
	.string "A volte incontrerai avversari\n"
	.string "e POKéMON selvatici.\n"
	.string "Non arrenderti mai!$"

gPikachuIntro_Text_Page3::
	.string "Conoscerai persone diverse\n"
	.string "e imparerai molte cose.\n\n"
	.string "Premi A per iniziare\n"
	.string "la tua avventura!$"

gOakSpeech_Text_WelcomeToTheWorld::
	.string "Ciao! Piacere di conoscerti!\p"
	.string "Benvenuto nel mondo dei POKéMON!\p"
	.string "Mi chiamo OAK.\p"
	.string "Tutti mi chiamano PROFESSORE\n"
	.string "POKéMON.\p$"

gOakSpeech_Text_ThisWorld::
	.string "Questo mondo...$"

gOakSpeech_Text_IsInhabitedFarAndWide::
	.string "...e' abitato da creature\n"
	.string "chiamate POKéMON.\p$"

gOakSpeech_Text_IStudyPokemon::
	.string "Per alcuni sono amici fedeli.\n"
	.string "Altri li allenano per lottare.\p"
	.string "Io invece...\p"
	.string "studio i POKéMON da una vita.\p$"

gOakSpeech_Text_TellMeALittleAboutYourself::
	.string "Ma prima vorrei sapere\n"
	.string "qualcosa di te.\p$"

gOakSpeech_Text_YourNameWhatIsIt::
	.string "Cominciamo dal tuo nome.\n"
	.string "Come ti chiami?\p$"

gOakSpeech_Text_SoYourNameIsPlayer::
	.string "Dunque...\n"
	.string "Ti chiami {PLAYER}.$"

gOakSpeech_Text_WhatWasHisName::
	.string "Questo e' mio nipote.\p"
	.string "Siete rivali fin da piccoli.\p"
	.string "Accidenti... come si chiama?$"

gOakSpeech_Text_YourRivalsNameWhatWasIt::
	.string "Come si chiamava il tuo rivale?$"

gOakSpeech_Text_ConfirmRivalName::
	.string "Ah... era {RIVAL}, vero?$"

gOakSpeech_Text_RememberRivalsName::
	.string "Giusto! Ora ricordo!\n"
	.string "Si chiama {RIVAL}!\p$"

gOakSpeech_Text_LetsGo::
	.string "{PLAYER}!\p"
	.string "La tua avventura sta per iniziare.\p"
	.string "KANTO ti aspetta, insieme a\n"
	.string "mille scoperte e nuove amicizie!$"

